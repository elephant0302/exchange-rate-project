# Database — SQLite by default. Switch to PostgreSQL later:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/fx
DATABASE_URL=sqlite:///./data/fx.db

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# development | production
ENVIRONMENT=development

# frankfurter | mock
EXCHANGE_PROVIDER=frankfurter

# rss | mock
NEWS_PROVIDER=rss

# If the live provider fails and no stored data exists, generate labeled mock data
ALLOW_MOCK_FALLBACK=true

# Optional override. Default: https://api.frankfurter.dev/v1
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1

# Earliest date requested from the FX provider (YYYY-MM-DD)
HISTORY_START_DATE=2020-01-01

HTTP_TIMEOUT_SECONDS=30

# Background jobs. Multiple app instances will each run the scheduler.
SCHEDULER_ENABLED=true
EXCHANGE_SYNC_MINUTES=360
NEWS_SYNC_MINUTES=60
FORECAST_SYNC_MINUTES=720
NEWS_CLEANUP_HOURS=24
NEWS_RETENTION_DAYS=1200
NEWS_HISTORY_MONTHS=24
NEWS_HISTORY_MIN_PER_MONTH=2
NEWS_HISTORY_BATCH_MONTHS=8

# Admin POST endpoints. Disable or add auth before production.
ADMIN_API_ENABLED=true
AUTO_INGEST_ON_STARTUP=true

# Optional extra RSS feeds (comma-separated). Google News + BBC Business are built in.
# NEWS_RSS_URLS=

# Standard proxy variables are honored by httpx (corporate networks)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
